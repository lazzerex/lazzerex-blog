---
import DesktopShellLayout from "../../layouts/DesktopShellLayout.astro";
import { getAllPosts, getPostBySlug } from "../../lib/posts";
import { getTagColor } from "../../lib/tags";

export async function getStaticPaths() {
  const posts = await getAllPosts();

  return posts.map((post) => ({
    params: { slug: post.slug }
  }));
}

const { slug } = Astro.params;

if (!slug) {
  throw new Error("Missing slug parameter for blog detail route.");
}

const post = await getPostBySlug(slug);

if (!post) {
  throw new Error(`Unable to resolve post for slug \"${slug}\".`);
}

const canonicalUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : undefined;
const ogImage = (() => {
  if (!post.cover) {
    return undefined;
  }

  if (/^https?:\/\//i.test(post.cover)) {
    return post.cover;
  }

  if (!Astro.site) {
    return undefined;
  }

  return new URL(post.cover, Astro.site).toString();
})();

const allPosts = await getAllPosts();
const currentIndex = allPosts.findIndex((candidate) => candidate.slug === post.slug);
const newerPost = currentIndex > 0 ? allPosts[currentIndex - 1] : undefined;
const olderPost = currentIndex < allPosts.length - 1 ? allPosts[currentIndex + 1] : undefined;

const relatedPosts = allPosts
  .filter((candidate) => candidate.slug !== post.slug)
  .map((candidate) => ({
    post: candidate,
    sharedTags: candidate.tags.filter((tag) => post.tags.includes(tag)).length
  }))
  .filter((entry) => entry.sharedTags > 0)
  .sort((a, b) => b.sharedTags - a.sharedTags || b.post.date.getTime() - a.post.date.getTime())
  .slice(0, 3)
  .map((entry) => entry.post);
---

<DesktopShellLayout
  title={`Lazzerex | ${post.title}`}
  description={post.summary}
  ogType="article"
  ogImage={ogImage}
  canonicalUrl={canonicalUrl}
  currentPath="/"
  expand
>
  <section class="content-window article-window detail-window">
    <div class="window-path">
      <p class="window-path-segments" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="path-muted">→</span>
        <a href="/">Articles</a>
        <span class="path-muted">→</span>
        <span>{post.title}</span>
      </p>
    </div>

    <article class="reader-article">
      <header class="reader-header">
        <h1>{post.title}</h1>
        <p class="reader-meta">
          <span>{post.author}</span>
          <span class="reader-meta-dot" aria-hidden="true">•</span>
          <time datetime={post.date.toISOString()}>{post.dateLabel}</time>
          <span class="reader-meta-dot" aria-hidden="true">•</span>
          <span>{post.readTimeMinutes} min read</span>
          <span class="reader-meta-dot" aria-hidden="true">•</span>
          <span><span data-view-count>--</span> views</span>
        </p>
        <ul class="reader-tags" aria-label="Post tags">
          {
            post.tags.map((tag) => (
              <li style={`--tag-color:${getTagColor(tag)}`}>{tag}</li>
            ))
          }
        </ul>
        <p class="reader-summary">{post.summary}</p>
      </header>

      <div class="reader-cover-wrap">
        <img
          class="reader-cover"
          src={post.cover}
          alt={`Cover image for ${post.title}`}
          width="1200"
          height="675"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>

      {
        post.toc.length > 1 && (
          <details class="reader-toc">
            <summary>Contents</summary>
            <ul>
              {post.toc.map((entry) => (
                <li style={`--toc-level: ${Math.min(entry.level, 4)}`}>
                  <a href={`#${entry.id}`}>{entry.text}</a>
                </li>
              ))}
            </ul>
          </details>
        )
      }

      <div class="reader-content">
        {
          post.blocks.map((block) => {
            if (block.type === "heading") {
              if (block.level === 1 || block.level === 2) {
                return <h2 id={block.id}>{block.text}</h2>;
              }

              if (block.level === 3) {
                return <h3 id={block.id}>{block.text}</h3>;
              }

              return <h4 id={block.id}>{block.text}</h4>;
            }

            if (block.type === "paragraph") {
              return <p>{block.text}</p>;
            }

            if (block.type === "quote") {
              return <blockquote>{block.text}</blockquote>;
            }

            if (block.type === "list-item") {
              if (block.ordered) {
                return (
                  <ol>
                    <li>{block.text}</li>
                  </ol>
                );
              }

              return (
                <ul>
                  <li>{block.text}</li>
                </ul>
              );
            }

            if (block.type === "code") {
              return (
                <div class="code-block" data-language={block.language || undefined}>
                  {block.html ? (
                    <Fragment set:html={block.html} />
                  ) : (
                    <pre><code>{block.code}</code></pre>
                  )}
                </div>
              );
            }

            if (block.type === "image") {
              return (
                <figure>
                  <img
                    src={block.src}
                    alt={block.alt || "Article image"}
                    width={block.width}
                    height={block.height}
                    loading="lazy"
                    decoding="async"
                  />
                  {block.alt && <figcaption>{block.alt}</figcaption>}
                </figure>
              );
            }

            if (block.type === "divider") {
              return <hr />;
            }

            return null;
          })
        }
      </div>

      {
        post.notionUrl && (
          <p class="reader-source">
            Source:&nbsp;
            <a href={post.notionUrl} target="_blank" rel="noopener noreferrer">
              Published Notion page
            </a>
          </p>
        )
      }

      {
        (newerPost || olderPost) && (
          <nav class="reader-adjacent" aria-label="Post navigation">
            {olderPost && (
              <a class="reader-adjacent-link" href={`/blog/${olderPost.slug}`} data-astro-prefetch>
                <span class="reader-adjacent-label">Older</span>
                <span class="reader-adjacent-title">{olderPost.title}</span>
              </a>
            )}
            {newerPost && (
              <a class="reader-adjacent-link reader-adjacent-newer" href={`/blog/${newerPost.slug}`} data-astro-prefetch>
                <span class="reader-adjacent-label">Newer</span>
                <span class="reader-adjacent-title">{newerPost.title}</span>
              </a>
            )}
          </nav>
        )
      }

      {
        relatedPosts.length > 0 && (
          <section class="reader-related" aria-label="Related articles">
            <h2>Related Articles</h2>
            <ul>
              {relatedPosts.map((relatedPost) => (
                <li>
                  <a href={`/blog/${relatedPost.slug}`} data-astro-prefetch>
                    <span class="reader-related-title">{relatedPost.title}</span>
                    <span class="reader-related-meta">{relatedPost.primaryTag} · {relatedPost.dateLabel}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      <section class="reader-engagement" aria-label="Post engagement">
        <section class="engagement-reaction-panel" aria-label="Post reactions">
          <p class="engagement-panel-kicker">This article</p>
          <h2>Post Reactions</h2>
          <div class="engagement-like-row">
            <button type="button" class="engagement-like-button" data-like-toggle aria-pressed="false">
              Like Post
            </button>
            <p class="engagement-like-meta"><span data-like-count>0</span> likes</p>
          </div>
          <p class="engagement-like-status" data-like-status aria-live="polite"></p>
        </section>

        <section class="engagement-compose-panel" aria-label="Write a comment">
          <p class="engagement-panel-kicker">Join the conversation</p>
          <h2>Write a Comment</h2>
          <p class="engagement-compose-note">Share your thought about this article.</p>

          <form class="engagement-comment-form" data-comment-form>
            <label for="comment-author">Name (optional)</label>
            <input id="comment-author" name="authorName" type="text" maxlength="60" data-comment-author />

            <label for="comment-body">Comment</label>
            <textarea
              id="comment-body"
              name="body"
              rows="4"
              maxlength="1200"
              minlength="3"
              required
              data-comment-body
            ></textarea>

            <div class="engagement-compose-actions">
              <p class="engagement-compose-status" data-comment-compose-status aria-live="polite"></p>
              <button type="submit" class="comment-submit" data-comment-submit>Post Comment</button>
            </div>
          </form>
        </section>

        <section class="engagement-comments engagement-comments-panel" aria-label="Comments">
          <div class="engagement-comments-header">
            <h2>Comments</h2>
            <p class="engagement-comments-status" data-comments-status>Loading comments...</p>
          </div>
          <ul class="engagement-comments-list" data-comments-list></ul>
        </section>
      </section>
    </article>
  </section>

  <script is:inline define:vars={{ postSlug: post.slug, postTitle: post.title }}>
    (() => {
      const runtimeReadyEvent = 'lazzerex:runtime-api-ready';
      const getRuntimeApi = () => {
        const candidate = window.lazzerexRuntimeApi;
        if (candidate && typeof candidate === 'object') {
          return candidate;
        }

        return null;
      };

      const likeButton = document.querySelector('[data-like-toggle]');
      const viewCountValue = document.querySelector('[data-view-count]');
      const likeCountValue = document.querySelector('[data-like-count]');
      const likeStatus = document.querySelector('[data-like-status]');
      const commentsStatus = document.querySelector('[data-comments-status]');
      const composeStatus = document.querySelector('[data-comment-compose-status]');
      const commentsList = document.querySelector('[data-comments-list]');
      const commentForm = document.querySelector('[data-comment-form]');
      const commentAuthorInput = commentForm?.querySelector('[data-comment-author]');
      const commentBodyInput = commentForm?.querySelector('[data-comment-body]');
      const commentSubmitButton = commentForm?.querySelector('[data-comment-submit]');

      const commentsDateFormatter = new Intl.DateTimeFormat('en-US', {
        month: 'short',
        day: 'numeric',
        year: 'numeric'
      });

      const setCommentsStatus = (text, isError = false) => {
        if (!(commentsStatus instanceof HTMLElement)) {
          return;
        }

        commentsStatus.textContent = text;
        commentsStatus.classList.toggle('is-error', isError);
      };

      const setLikeStatus = (text, isError = false) => {
        if (!(likeStatus instanceof HTMLElement)) {
          return;
        }

        likeStatus.textContent = text;
        likeStatus.classList.toggle('is-error', isError);
      };

      const setComposeStatus = (text, isError = false) => {
        if (!(composeStatus instanceof HTMLElement)) {
          return;
        }

        composeStatus.textContent = text;
        composeStatus.classList.toggle('is-error', isError);
      };

      const setEngagementPendingState = () => {
        if (likeButton instanceof HTMLButtonElement) {
          likeButton.disabled = true;
        }

        if (commentSubmitButton instanceof HTMLButtonElement) {
          commentSubmitButton.disabled = true;
        }

        setLikeStatus('Connecting to engagement service...');
        setCommentsStatus('Connecting to comments service...');
        setComposeStatus('Connecting to comment service...');
      };

      const setEngagementReadyState = () => {
        if (likeButton instanceof HTMLButtonElement) {
          likeButton.disabled = false;
        }

        if (commentSubmitButton instanceof HTMLButtonElement) {
          commentSubmitButton.disabled = false;
        }

        setLikeStatus('');
        setComposeStatus('');
      };

      const visitorTokenStorageKey = 'lazzerex:visitor-token';
      const getVisitorToken = () => {
        const generateToken = () => {
          if (window.crypto && typeof window.crypto.randomUUID === 'function') {
            return window.crypto.randomUUID().replace(/-/g, '');
          }

          if (window.crypto && typeof window.crypto.getRandomValues === 'function') {
            const bytes = new Uint8Array(16);
            window.crypto.getRandomValues(bytes);
            return Array.from(bytes, (value) => value.toString(16).padStart(2, '0')).join('');
          }

          return `${Date.now().toString(36)}${Math.random().toString(36).slice(2, 18)}`;
        };

        try {
          const storedToken = String(localStorage.getItem(visitorTokenStorageKey) || '').trim();
          if (/^[a-zA-Z0-9_-]{16,128}$/.test(storedToken)) {
            return storedToken;
          }

          const token = generateToken();
          localStorage.setItem(visitorTokenStorageKey, token);
          return token;
        } catch {
          return generateToken();
        }
      };

      const visitorToken = getVisitorToken();

      let reactionCount = 0;
      let isLiked = false;
      let visibleCommentCount = 0;
      let hasViewIncrementRequestBeenSent = false;
      let recoverySyncHandle = 0;

      const updateViewCountUI = (count) => {
        if (!(viewCountValue instanceof HTMLElement)) {
          return;
        }

        const normalizedCount = Number(count);
        if (!Number.isFinite(normalizedCount) || normalizedCount < 0) {
          viewCountValue.textContent = '--';
          return;
        }

        viewCountValue.textContent = String(Math.floor(normalizedCount));
      };

      const updateLikeUI = () => {
        if (!(likeButton instanceof HTMLButtonElement)) {
          return;
        }

        likeButton.setAttribute('aria-pressed', isLiked ? 'true' : 'false');
        likeButton.textContent = isLiked ? 'Liked Post' : 'Like Post';
        likeButton.classList.toggle('is-active', isLiked);

        if (likeCountValue instanceof HTMLElement) {
          likeCountValue.textContent = String(Math.max(0, reactionCount));
        }
      };

      const updateCommentCountStatus = () => {
        if (visibleCommentCount === 0) {
          setCommentsStatus('No comments yet. Be the first one to add your thoughts.');
          return;
        }

        setCommentsStatus(`${visibleCommentCount} comment${visibleCommentCount === 1 ? '' : 's'}`);
      };

      const formatCommentDate = (isoLike) => {
        const parsedDate = new Date(String(isoLike || ''));
        if (Number.isNaN(parsedDate.getTime())) {
          return '';
        }

        return commentsDateFormatter.format(parsedDate);
      };

      const renderCommentItem = (comment) => {
        const listItem = document.createElement('li');
        listItem.className = 'engagement-comment-item';

        const header = document.createElement('p');
        header.className = 'engagement-comment-header';

        const name = document.createElement('strong');
        name.textContent = String(comment?.authorName || 'Anonymous');
        header.appendChild(name);

        const dateText = formatCommentDate(comment?.createdAt);
        if (dateText) {
          const separator = document.createElement('span');
          separator.textContent = ' • ';
          header.appendChild(separator);

          const date = document.createElement('span');
          date.textContent = dateText;
          header.appendChild(date);
        }

        const body = document.createElement('p');
        body.className = 'engagement-comment-body';
        body.textContent = String(comment?.body || '').trim();

        listItem.appendChild(header);
        listItem.appendChild(body);

        return listItem;
      };

      const loadReactionState = async () => {
        const runtimeApi = getRuntimeApi();
        if (!runtimeApi || typeof runtimeApi.getReactions !== 'function') {
          updateLikeUI();
          return false;
        }

        const response = await runtimeApi.getReactions(postSlug, visitorToken, {
          retries: 2,
          timeoutMs: 3600
        });
        if (!response) {
          updateLikeUI();
          setLikeStatus('Engagement service is waking up. Retrying shortly...', true);
          return false;
        }

        reactionCount = Number(response.count || 0);
        isLiked = Boolean(response.liked);
        updateLikeUI();
        setLikeStatus('');
        return true;
      };

      const loadComments = async () => {
        if (!(commentsList instanceof HTMLElement)) {
          return false;
        }

        const runtimeApi = getRuntimeApi();
        if (!runtimeApi || typeof runtimeApi.getComments !== 'function') {
          setCommentsStatus('Comments are currently unavailable.', true);
          return false;
        }

        const response = await runtimeApi.getComments(postSlug, {
          limit: 40,
          retries: 2,
          timeoutMs: 4200
        });

        if (!response || !Array.isArray(response.comments)) {
          setCommentsStatus('Comments service is waking up. Retrying shortly...', true);
          return false;
        }

        const commentsFragment = document.createDocumentFragment();
        visibleCommentCount = response.comments.length;
        response.comments.forEach((comment) => {
          const commentItem = renderCommentItem(comment);
          if (commentItem) {
            commentsFragment.appendChild(commentItem);
          }
        });

        commentsList.innerHTML = '';
        commentsList.appendChild(commentsFragment);
        updateCommentCountStatus();
        return true;
      };

      const loadViewCount = async () => {
        const runtimeApi = getRuntimeApi();
        if (!runtimeApi) {
          return false;
        }

        if (typeof runtimeApi.getViews === 'function') {
          const currentViewState = await runtimeApi.getViews(postSlug, {
            retries: 2,
            timeoutMs: 3600
          });

          if (currentViewState) {
            updateViewCountUI(currentViewState.count);
            return true;
          }
        }

        return false;
      };

      const syncViewCounter = async () => {
        const initialViewReadSucceeded = await loadViewCount();

        const runtimeApi = getRuntimeApi();
        if (!runtimeApi || typeof runtimeApi.incrementView !== 'function') {
          return initialViewReadSucceeded;
        }

        if (hasViewIncrementRequestBeenSent) {
          return initialViewReadSucceeded;
        }

        hasViewIncrementRequestBeenSent = true;

        const incrementedViewState = await runtimeApi.incrementView(postSlug, {
          timeoutMs: 4200
        });

        if (incrementedViewState) {
          updateViewCountUI(incrementedViewState.count);
          return true;
        }

        const fallbackViewReadSucceeded = await loadViewCount();
        return initialViewReadSucceeded || fallbackViewReadSucceeded;
      };

      const scheduleRecoverySync = (delayMs = 6500) => {
        if (recoverySyncHandle !== 0) {
          return;
        }

        recoverySyncHandle = window.setTimeout(() => {
          recoverySyncHandle = 0;
          void loadViewCount();
          void loadReactionState();
          void loadComments();
        }, delayMs);
      };

      if (likeButton instanceof HTMLButtonElement) {
        updateLikeUI();

        likeButton.addEventListener('click', async () => {
          const runtimeApi = getRuntimeApi();
          if (!runtimeApi || typeof runtimeApi.toggleReaction !== 'function') {
            setLikeStatus('Post reactions are currently unavailable.', true);
            return;
          }

          likeButton.disabled = true;
          setLikeStatus('Updating post reaction...');

          const response = await runtimeApi.toggleReaction(postSlug, visitorToken, {
            postTitle,
            timeoutMs: 2400
          });

          if (response) {
            reactionCount = Number(response.count || 0);
            isLiked = Boolean(response.liked);
            updateLikeUI();
            setLikeStatus('');

            if (typeof runtimeApi.track === 'function') {
              runtimeApi.track(
                {
                  slug: postSlug,
                  event: isLiked ? 'like' : 'unlike',
                  metadata: {
                    source: 'detail_page'
                  }
                },
                {
                  retries: 0,
                  timeoutMs: 1200
                }
              );
            }
          } else {
            const reloadedReaction = await loadReactionState();
            if (!reloadedReaction) {
              setLikeStatus('Unable to update post reaction right now.', true);
              scheduleRecoverySync();
            }
          }

          likeButton.disabled = false;
        });
      }

      if (
        commentForm instanceof HTMLFormElement &&
        commentBodyInput instanceof HTMLTextAreaElement &&
        commentSubmitButton instanceof HTMLButtonElement
      ) {
        commentForm.addEventListener('submit', async (event) => {
          event.preventDefault();

          const commentBody = commentBodyInput.value.trim();
          if (commentBody.length < 3) {
            setComposeStatus('Comment must be at least 3 characters.', true);
            return;
          }

          const runtimeApi = getRuntimeApi();
          if (!runtimeApi || typeof runtimeApi.postComment !== 'function') {
            setComposeStatus('Comments are currently unavailable.', true);
            return;
          }

          commentSubmitButton.disabled = true;
          setComposeStatus('Posting your comment...');

          const response = await runtimeApi.postComment(
            {
              slug: postSlug,
              authorName: commentAuthorInput instanceof HTMLInputElement ? commentAuthorInput.value : '',
              body: commentBody,
              postTitle
            },
            {
              timeoutMs: 2800
            }
          );

          if (!response || !response.comment) {
            const reloadedComments = await loadComments();
            if (reloadedComments) {
              setComposeStatus('Comment service reconnected. Please check the comments list.', false);
            } else {
              setComposeStatus('Unable to post comment right now.', true);
              scheduleRecoverySync();
            }
            commentSubmitButton.disabled = false;
            return;
          }

          if (commentsList instanceof HTMLElement) {
            const newCommentItem = renderCommentItem(response.comment);
            if (newCommentItem) {
              commentsList.prepend(newCommentItem);
            }
          }

          visibleCommentCount += 1;
          updateCommentCountStatus();
          commentBodyInput.value = '';
          setComposeStatus('Comment posted.', false);

          if (typeof runtimeApi.track === 'function') {
            runtimeApi.track(
              {
                slug: postSlug,
                event: 'comment_submit',
                metadata: {
                  source: 'detail_page'
                }
              },
              {
                retries: 0,
                timeoutMs: 1200
              }
            );
          }

          commentSubmitButton.disabled = false;
        });
      }

      setEngagementPendingState();

      const runtimeWaitHandle = window.setTimeout(() => {
        if (!getRuntimeApi()) {
          setLikeStatus('Post reactions are currently unavailable.', true);
          setCommentsStatus('Comments are currently unavailable.', true);
          setComposeStatus('Comment service is currently unavailable.', true);
        }
      }, 5000);

      const initializeEngagement = () => {
        if (!getRuntimeApi()) {
          return;
        }

        window.clearTimeout(runtimeWaitHandle);
        setEngagementReadyState();

        const hydrateEngagement = async () => {
          const [viewsReady, reactionReady, commentsReady] = await Promise.all([
            syncViewCounter(),
            loadReactionState(),
            loadComments()
          ]);

          if (!viewsReady || !reactionReady || !commentsReady) {
            scheduleRecoverySync();
          }
        };

        const runtimeApi = getRuntimeApi();
        if (runtimeApi && typeof runtimeApi.track === 'function') {
          runtimeApi.track(
            {
              slug: postSlug,
              event: 'open_detail',
              metadata: {
                source: 'detail_page'
              }
            },
            {
              retries: 1,
              timeoutMs: 2000
            }
          );
        }

        void hydrateEngagement();
      };

      if (getRuntimeApi()) {
        initializeEngagement();
      } else {
        window.addEventListener(runtimeReadyEvent, initializeEngagement, { once: true });
      }
    })();
  </script>
</DesktopShellLayout>
