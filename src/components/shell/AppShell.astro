---
import TopBar from "./TopBar.astro";
import SidebarNav from "./SidebarNav.astro";
import DockBar from "./DockBar.astro";
import { ArrowUp } from "lucide-astro";

interface Props {
  currentPath: string;
  expand?: boolean;
}

const { currentPath, expand = false } = Astro.props;
---

{
  expand && (
    <div class="reading-progress" aria-hidden="true">
      <div class="reading-progress-bar" data-reading-progress />
    </div>
  )
}

<div class="page-frame">
  <div class:list={["shell-container", { "is-expanded": expand }]}>
    <TopBar />

    <div class="shell-body">
      <SidebarNav currentPath={currentPath} />

      <main id="main-content" class="content-panel" tabindex="-1">
        <slot />
      </main>
    </div>

    <DockBar currentPath={currentPath} />
  </div>
</div>

{
  expand && (
    <button type="button" class="back-to-top" data-back-to-top aria-label="Back to top" hidden>
      <ArrowUp size={18} strokeWidth={2} />
    </button>
  )
}

<script>
  const glassToggleButton = document.querySelector<HTMLButtonElement>("[data-glass-toggle]");

  if (glassToggleButton) {
    const body = document.body;
    const storageKey = "lazzerex:blog-glass-enabled";

    const applyPreference = (enabled: boolean) => {
      body.classList.toggle("glass-disabled", !enabled);
      glassToggleButton.setAttribute("aria-pressed", enabled ? "true" : "false");
      glassToggleButton.textContent = enabled ? "Glass: On" : "Glass: Off";
    };

    const readPreference = (): boolean => {
      try {
        const stored = localStorage.getItem(storageKey);
        if (stored === "on" || stored === "off") {
          return stored === "on";
        }
      } catch {
        return true;
      }

      // No stored preference yet: default off on memory/CPU-constrained devices.
      const nav = navigator as Navigator & { deviceMemory?: number };
      const isLowPowerDevice =
        (typeof nav.deviceMemory === "number" && nav.deviceMemory <= 4) ||
        (typeof nav.hardwareConcurrency === "number" && nav.hardwareConcurrency <= 4);

      return !isLowPowerDevice;
    };

    const writePreference = (enabled: boolean) => {
      try {
        localStorage.setItem(storageKey, enabled ? "on" : "off");
      } catch {
        // ignore
      }
    };

    let isGlassEnabled = readPreference();
    applyPreference(isGlassEnabled);

    glassToggleButton.addEventListener("click", () => {
      isGlassEnabled = !isGlassEnabled;
      applyPreference(isGlassEnabled);
      writePreference(isGlassEnabled);
    });
  }

  const progressBar = document.querySelector<HTMLElement>("[data-reading-progress]");
  const backToTopButton = document.querySelector<HTMLButtonElement>("[data-back-to-top]");

  if (progressBar || backToTopButton) {
    const updateOnScroll = () => {
      const scrollTop = window.scrollY;

      if (progressBar) {
        const scrollable = document.documentElement.scrollHeight - window.innerHeight;
        const ratio = scrollable > 0 ? Math.min(1, Math.max(0, scrollTop / scrollable)) : 0;
        progressBar.style.transform = `scaleX(${ratio})`;
      }

      if (backToTopButton) {
        backToTopButton.hidden = scrollTop < 480;
      }
    };

    window.addEventListener("scroll", updateOnScroll, { passive: true });
    window.addEventListener("resize", updateOnScroll);
    updateOnScroll();

    backToTopButton?.addEventListener("click", () => {
      const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      window.scrollTo({ top: 0, behavior: prefersReducedMotion ? "auto" : "smooth" });
    });
  }
</script>
